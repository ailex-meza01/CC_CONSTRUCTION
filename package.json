{
  "name": "cc-construction-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n FRONT,API -c cyan,green \"npm run dev:front\" \"npm run dev:api\"",
    "dev:front": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist-server/index.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "mssql": "^12.5.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
